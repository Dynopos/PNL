# Supabase project settings (Project Settings → API).
# Only the public anon key belongs here — never the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: Edge Function slug for the voice parser (default parse-voice).
VITE_PARSE_VOICE_FUNCTION=parse-voice
